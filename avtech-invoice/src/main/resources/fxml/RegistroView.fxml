<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" prefHeight="600.0" prefWidth="450.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.avtech.view.RegistroController">
    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>

    <Label text="Crear Nueva Cuenta">
        <font>
            <Font name="System Bold" size="22.0" />
        </font>
    </Label>
    <Label text="Introduce tus datos fiscales para la facturación" textFill="#666666" />

    <GridPane hgap="10" vgap="15" VBox.vgrow="ALWAYS" alignment="CENTER">
        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" minWidth="120" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>

        <Label text="Email:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
        <TextField fx:id="txtEmail" promptText="ejemplo@correo.com" GridPane.rowIndex="0" GridPane.columnIndex="1" />

        <Label text="Contraseña:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
        <PasswordField fx:id="txtPassword" promptText="Tu contraseña segura" GridPane.rowIndex="1" GridPane.columnIndex="1" />

        <Label text="Nombre Fiscal:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
        <TextField fx:id="txtNombreFiscal" promptText="Tu Nombre o Empresa" GridPane.rowIndex="2" GridPane.columnIndex="1" />

        <Label text="NIF/CIF:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
        <TextField fx:id="txtNifCif" promptText="12345678A" GridPane.rowIndex="3" GridPane.columnIndex="1" />

        <Label text="Domicilio Fiscal:" GridPane.rowIndex="4" GridPane.columnIndex="0" />
        <TextField fx:id="txtDomicilio" promptText="Calle, Número, CP, Ciudad" GridPane.rowIndex="4" GridPane.columnIndex="1" />

        <Label text="IBAN Bancario:" GridPane.rowIndex="5" GridPane.columnIndex="0" />
        <TextField fx:id="txtIban" promptText="ESXX XXXX XXXX XXXX XXXX XXXX" GridPane.rowIndex="5" GridPane.columnIndex="1" />

        <Label text="IVA (%):" GridPane.rowIndex="6" GridPane.columnIndex="0" />
        <TextField fx:id="txtIva" text="21.00" promptText="Ej: 21.00" GridPane.rowIndex="6" GridPane.columnIndex="1" />

        <Label text="IRPF (%):" GridPane.rowIndex="7" GridPane.columnIndex="0" />
        <TextField fx:id="txtIrpf" text="15.00" promptText="Ej: 15.00" GridPane.rowIndex="7" GridPane.columnIndex="1" />
    </GridPane>

    <HBox alignment="CENTER" spacing="20.0">
        <Button fx:id="btnVolver" text="Cancelar" prefWidth="100.0"/>
        <Button fx:id="btnRegistrar" text="Registrarse" prefWidth="150.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" />
    </HBox>
</VBox>