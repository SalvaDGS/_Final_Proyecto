<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.avtech.view.UsuarioController">
    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>

    <Label text="Mi Perfil Fiscal">
        <font>
            <Font name="System Bold" size="22.0" />
        </font>
    </Label>
    <Label text="Modifica tus datos o elimina tu cuenta" textFill="#666666" />

    <GridPane hgap="10" vgap="15" VBox.vgrow="ALWAYS" alignment="CENTER" maxWidth="500">
        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" minWidth="120" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>

        <Label text="Email:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
        <TextField fx:id="txtEmail" GridPane.rowIndex="0" GridPane.columnIndex="1" />

        <Label text="Nueva Contraseña:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
        <PasswordField fx:id="txtPassword" promptText="Dejar en blanco para mantener la actual" GridPane.rowIndex="1" GridPane.columnIndex="1" />

        <Label text="Nombre Fiscal:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
        <TextField fx:id="txtNombreFiscal" GridPane.rowIndex="2" GridPane.columnIndex="1" />

        <Label text="NIF/CIF:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
        <TextField fx:id="txtNifCif" GridPane.rowIndex="3" GridPane.columnIndex="1" />

        <Label text="Domicilio Fiscal:" GridPane.rowIndex="4" GridPane.columnIndex="0" />
        <TextField fx:id="txtDomicilio" GridPane.rowIndex="4" GridPane.columnIndex="1" />

        <Label text="IBAN Bancario:" GridPane.rowIndex="5" GridPane.columnIndex="0" />
        <TextField fx:id="txtIban" GridPane.rowIndex="5" GridPane.columnIndex="1" />

        <Label text="IVA (%):" GridPane.rowIndex="6" GridPane.columnIndex="0" />
        <TextField fx:id="txtIva" GridPane.rowIndex="6" GridPane.columnIndex="1" />

        <Label text="IRPF (%):" GridPane.rowIndex="7" GridPane.columnIndex="0" />
        <TextField fx:id="txtIrpf" GridPane.rowIndex="7" GridPane.columnIndex="1" />
    </GridPane>

    <HBox alignment="CENTER" spacing="20.0" style="-fx-padding: 20 0 0 0;">
        <Button fx:id="btnEliminar" text="Eliminar Cuenta" prefWidth="150.0" style="-fx-background-color: #f44336; -fx-text-fill: white;" />
        <Button fx:id="btnActualizar" text="Guardar Cambios" prefWidth="150.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" />
    </HBox>
</VBox>